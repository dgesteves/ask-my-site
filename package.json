{
  "name": "ask-my-site",
  "version": "0.5.2",
  "description": "Self-hosted Ask AI for docs sites. Build-time static index, hybrid BM25 + vector retrieval in memory, streaming answers with citations. No vector database. Docusaurus and Starlight plugins, or one script tag.",
  "keywords": [
    "rag",
    "ai",
    "ai-sdk",
    "retrieval",
    "bm25",
    "embeddings",
    "command-palette",
    "docs-search",
    "edge",
    "react",
    "docusaurus",
    "docusaurus-plugin",
    "astro",
    "astro-integration",
    "withastro",
    "starlight",
    "starlight-plugin"
  ],
  "homepage": "https://github.com/dgesteves/ask-my-site#readme",
  "bugs": "https://github.com/dgesteves/ask-my-site/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/ask-my-site.git"
  },
  "license": "MIT",
  "author": "Diogo Esteves (https://github.com/dgesteves)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react/styles.css": "./dist/styles.css",
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./embed/launcher.css": "./dist/embed/launcher.css",
    "./docusaurus": {
      "types": "./dist/docusaurus/index.d.ts",
      "default": "./dist/docusaurus/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./starlight": {
      "types": "./dist/starlight/index.d.ts",
      "default": "./dist/starlight/index.js"
    },
    "./starlight/launcher.css": "./dist/starlight/launcher.css",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/embed.global.js",
  "jsdelivr": "./dist/embed.global.js",
  "bin": {
    "ask-my-site": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./react/styles.css ./embed/launcher.css ./starlight/launcher.css",
    "bench": "pnpm build && node --expose-gc bench/run.mjs",
    "assets": "node scripts/assets/architecture.mjs",
    "screenshot": "node scripts/assets/screenshot.mjs",
    "example:build": "pnpm build && pnpm --filter ask-my-site-example-nextjs build",
    "example:dev": "pnpm build && pnpm --filter ask-my-site-example-nextjs dev",
    "examples:sync": "node scripts/sync-example-docs.mjs",
    "examples:check": "node scripts/sync-example-docs.mjs --check",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm examples:check && pnpm example:build && pnpm --filter ask-my-site-example-nextjs lint && pnpm --filter ask-my-site-example-docusaurus build && pnpm --filter ask-my-site-example-starlight build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepack": "node scripts/npm-readme.mjs prepack",
    "postpack": "node scripts/npm-readme.mjs postpack"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@arethetypeswrong/cli": "^0.18.5",
    "@astrojs/starlight": "0.42.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.127",
    "astro": "7.3.6",
    "axe-core": "^4.14.0",
    "cmdk": "^1.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geist": "^1.7.2",
    "globals": "^17.13.0",
    "jiti": "1.21.7",
    "jsdom": "^30.1.2",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@ai-sdk/openai": ">=4",
    "@astrojs/starlight": ">=0.32.0",
    "@docusaurus/core": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "ai": "^7.0.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "cmdk": "^1.1.1",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@astrojs/starlight": {
      "optional": true
    },
    "@docusaurus/core": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
