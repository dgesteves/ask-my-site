{
  "name": "docusaurus-plugin-ondocs",
  "version": "0.7.0",
  "description": "The ondocs Docusaurus plugin, under the name Docusaurus users search for: a cited Ask AI box, an MCP server and llms.txt for your docs, from one static index, on your own function and key.",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "docusaurus-theme",
    "ask-ai",
    "ai-search",
    "chatbot",
    "docs-search",
    "search",
    "mcp",
    "mcp-server",
    "llms-txt",
    "rag",
    "ai"
  ],
  "homepage": "https://github.com/dgesteves/ondocs#readme",
  "bugs": "https://github.com/dgesteves/ondocs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/ondocs.git",
    "directory": "packages/docusaurus-plugin-ondocs"
  },
  "license": "MIT",
  "author": "Diogo Esteves (https://github.com/dgesteves)",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "ondocs": "workspace:*"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "cmdk": "^1.1.1",
    "ai": "^7.0.0",
    "@ai-sdk/openai": ">=4"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
