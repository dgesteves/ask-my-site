exports[`ondocs init: what it writes per host > Docusaurus in three locales on Netlify 1`] = `
{
  "netlify.toml": "# The index the ondocs functions answer from, bundled with them.
[functions.ask]
  included_files = ["build/ask-index.json", "build/fr/ask-index.json", "build/pt-BR/ask-index.json"]

[functions.mcp]
  included_files = ["build/ask-index.json", "build/fr/ask-index.json", "build/pt-BR/ask-index.json"]
",
  "netlify/functions/ask.mts": "// The ask endpoint, POST /api/ask, as a Netlify Function. Written by \`npx ondocs init\`: edit it as
// you like, and init asks before it overwrites it.
//
// It answers from build/ask-index.json, which the build writes and netlify.toml bundles with this
// function. Set OPENAI_API_KEY in the site's environment variables: the build embeds the pages with
// it, and this function embeds questions and calls the model.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { openai } from '@ai-sdk/openai';
import { createAskHandler, memoryRateLimit } from 'ondocs/server';

export default createAskHandler({
  index: () => readFile(join(process.cwd(), 'build/ask-index.json'), 'utf8'),
  // Each locale's index, which the dialog asks for on that locale's pages.
  indexes: {
    fr: () => readFile(join(process.cwd(), 'build/fr/ask-index.json'), 'utf8'),
    'pt-BR': () => readFile(join(process.cwd(), 'build/pt-BR/ask-index.json'), 'utf8'),
  },
  model: openai('gpt-5.4-mini'),
  // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
  // builds. The index records its model, and a different one here fails loudly. An index built
  // without a key has no vectors: it is searched by keywords, and this model is never called.
  embeddingModel: openai.embedding('text-embedding-3-small'),
  siteName: 'Acme Docs',
  // 10 questions a minute per client, keyed on x-nf-client-connection-ip, the client IP Netlify sets.
  rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000, trustedHeader: 'x-nf-client-connection-ip' }),
  // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
  // with your model provider as well; it is the only hard cap.
  budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
  // A question asked again is answered from memory, without a model call.
  answerCache: true,
});

export const config = { path: '/api/ask' };
",
  "netlify/functions/mcp.mts": "// The MCP endpoint, /api/mcp, as a Netlify Function. Written by \`npx ondocs init\`: edit it as you
// like, and init asks before it overwrites it.
//
// It serves build/ask-index.json to agents as search, fetch and list_pages tools. Search is
// keyword-only, so it calls no model: the agent brings its own.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { createMcpHandler, memoryRateLimit } from 'ondocs/server';

export default createMcpHandler({
  index: () => readFile(join(process.cwd(), 'build/ask-index.json'), 'utf8'),
  siteName: 'Acme Docs',
  // 60 tool calls a minute per client, keyed on x-nf-client-connection-ip, the client IP Netlify sets.
  rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000, trustedHeader: 'x-nf-client-connection-ip' }),
});

export const config = { path: '/api/mcp' };
",
}
`;

exports[`ondocs init: what it writes per host > Docusaurus in three locales on Netlify 2`] = `
"a Docusaurus site on Netlify.
Its other locales, fr, pt-BR, are answered from their own indexes, as the dialog asks.

  created    netlify/functions/ask.mts  POST /api/ask: answers questions from the index
  created    netlify/functions/mcp.mts  /api/mcp: the same index as an MCP server for agents, keyword-only
  updated    netlify.toml               bundles the index of each locale with the functions

Set (init reads none of these):
  OPENAI_API_KEY, for the functions and the site’s build: in the site's Environment variables, or netlify env:set OPENAI_API_KEY; without it there, the index is keyword-only, which works too

Next:
  1. npm i ondocs ai @ai-sdk/openai @radix-ui/react-dialog cmdk
  2. npm i -D @types/node (the functions' types)
  3. Add the plugin to docusaurus.config: plugins: ['ondocs/docusaurus']
  4. Deploy as you do now. init has deployed nothing."
`;

exports[`ondocs init: what it writes per host > Docusaurus on Cloudflare Pages, without a wrangler config 1`] = `
{
  "functions/api/ask.ts": "// The ask endpoint, POST /api/ask, as a Cloudflare Pages Function. Written by \`npx ondocs init\`:
// edit it as you like, and init asks before it overwrites it.
//
// It answers from /ask-index.json, which the build writes into the site's files, read through the
// ASSETS binding. Set OPENAI_API_KEY as a secret, for production and previews: in the dashboard
// (Settings, Variables and Secrets) or with \`npx wrangler pages secret put OPENAI_API_KEY\`. Set it
// as a build variable too: the build embeds the pages with it.
import { createOpenAI } from '@ai-sdk/openai';
import { createAskHandler, memoryRateLimit } from 'ondocs/server';

interface Env {
  OPENAI_API_KEY: string;
  ASSETS: { fetch: (request: Request) => Promise<Response> };
}

let handler: ((request: Request) => Promise<Response>) | undefined;

function create(request: Request, env: Env) {
  const openai = createOpenAI({ apiKey: env.OPENAI_API_KEY });
  return createAskHandler({
    index: async () => {
      const response = await env.ASSETS.fetch(new Request(new URL('/ask-index.json', request.url)));
      if (!response.ok) throw new Error(\`/ask-index.json: HTTP \${String(response.status)}\`);
      return response.text();
    },
    model: openai('gpt-5.4-mini'),
    // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
    // builds. The index records its model, and a different one here fails loudly. An index built
    // without a key has no vectors: it is searched by keywords, and this model is never called.
    embeddingModel: openai.embedding('text-embedding-3-small'),
    siteName: 'Acme Docs',
    // 10 questions a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
    rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
    // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
    // with your model provider as well; it is the only hard cap.
    budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
    // A question asked again is answered from memory, without a model call.
    answerCache: true,
  });
}

export const onRequest = ({ request, env }: { request: Request; env: Env }): Promise<Response> => {
  handler ??= create(request, env);
  return handler(request);
};
",
  "functions/api/mcp.ts": "// The MCP endpoint, /api/mcp, as a Cloudflare Pages Function. Written by \`npx ondocs init\`: edit it
// as you like, and init asks before it overwrites it.
//
// It serves /ask-index.json to agents as search, fetch and list_pages tools. Search is
// keyword-only, so it calls no model: the agent brings its own.
import { createMcpHandler, memoryRateLimit } from 'ondocs/server';

interface Env {
  ASSETS: { fetch: (request: Request) => Promise<Response> };
}

let handler: ((request: Request) => Promise<Response>) | undefined;

export const onRequest = ({ request, env }: { request: Request; env: Env }): Promise<Response> => {
  handler ??= createMcpHandler({
    index: async () => {
      const response = await env.ASSETS.fetch(new Request(new URL('/ask-index.json', request.url)));
      if (!response.ok) throw new Error(\`/ask-index.json: HTTP \${String(response.status)}\`);
      return response.text();
    },
    siteName: 'Acme Docs',
    // 60 tool calls a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
    rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
  });
  return handler(request);
};
",
}
`;

