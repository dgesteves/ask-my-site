exports[`ask-my-site init: what it writes per host > Docusaurus on GitHub Pages 1`] = `
{
  "ask-my-site-worker/package.json": "{
  "name": "acme-docs-ask",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "ask-my-site": "^<version>"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
",
  "ask-my-site-worker/src/index.ts": "// The Worker that answers questions for Acme Docs. Written by \`npx ask-my-site init\`: edit it as
// you like, and init asks before it overwrites it.
//
// It fetches the index from the live site, SITE_URL/ask-index.json, and checks it again every five
// minutes, so it follows the site's deploys. The site's pages call it across origins, so it sends
// CORS headers for SITE_URL's origin, and only for it.
//
// Set the key with \`npx wrangler secret put OPENAI_API_KEY\`, and deploy with \`npx wrangler deploy\`.
import { createOpenAI } from '@ai-sdk/openai';
import {
  createAskHandler,
  createMcpHandler,
  memoryRateLimit,
  remoteIndex,
} from 'ask-my-site/server';

interface Env {
  SITE_URL: string;
  OPENAI_API_KEY: string;
}

type Handler = (request: Request) => Promise<Response>;
let handlers: { ask: Handler; mcp: Handler } | undefined;

function create(env: Env) {
  const site = new URL(\`\${env.SITE_URL.replace(/\\/+$/, '')}/\`);
  const index = remoteIndex(new URL('ask-index.json', site));
  const openai = createOpenAI({ apiKey: env.OPENAI_API_KEY });
  return {
    ask: createAskHandler({
      index,
      model: openai('gpt-5.4-mini'),
      // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
      // builds. The index records its model, and a different one here fails loudly. An index built
      // without a key has no vectors: it is searched by keywords, and this model is never called.
      embeddingModel: openai.embedding('text-embedding-3-small'),
      siteName: 'Acme Docs',
      // 10 questions a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
      rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
      // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
      // with your model provider as well; it is the only hard cap.
      budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
      // A question asked again is answered from memory, without a model call.
      answerCache: true,
      // The site's pages post here from their own origin.
      headers: {
        'access-control-allow-origin': site.origin,
        'access-control-allow-methods': 'POST, OPTIONS',
        'access-control-allow-headers': 'content-type',
        'access-control-max-age': '86400',
        vary: 'origin',
      },
    }),
    mcp: createMcpHandler({
      index,
      siteName: 'Acme Docs',
      // 60 tool calls a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
      rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
      // Results link to the pages on the site, not on this Worker.
      siteUrl: site.origin,
    }),
  };
}

export default {
  fetch(request: Request, env: Env): Promise<Response> {
    handlers ??= create(env);
    const { pathname } = new URL(request.url);
    if (pathname === '/api/ask') return handlers.ask(request);
    if (pathname === '/api/mcp') return handlers.mcp(request);
    return Promise.resolve(new Response('Not found', { status: 404 }));
  },
};
",
  "ask-my-site-worker/wrangler.jsonc": "// The Worker that answers questions for Acme Docs. Written by \`npx ask-my-site init\`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acme-docs-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // The site the Worker answers for: it reads the index at https://acme.github.io/docs/ask-index.json.
    "SITE_URL": "https://acme.github.io/docs"
  }
}
",
}
`;

exports[`ask-my-site init: what it writes per host > Docusaurus on GitHub Pages 2`] = `
"a Docusaurus site on GitHub Pages, answered by a Cloudflare Worker.

  created    ask-my-site-worker/package.json    the Worker’s dependencies and scripts
  created    ask-my-site-worker/wrangler.jsonc  the Worker’s configuration, with the site’s URL
  created    ask-my-site-worker/src/index.ts    the Worker: POST /api/ask and /api/mcp, from the live site’s index

Set (init reads none of these):
  OPENAI_API_KEY, for the Worker: cd ask-my-site-worker && npx wrangler secret put OPENAI_API_KEY
  OPENAI_API_KEY, for the site’s build: a repository secret, for a GitHub Actions build; without it there, the index is keyword-only, which works too

Next:
  1. npm i ask-my-site ai @ai-sdk/openai @radix-ui/react-dialog cmdk
  2. cd ask-my-site-worker && npm install && npx wrangler deploy (it prints the Worker's URL, https://acme-docs-ask.<your-subdomain>.workers.dev)
  3. Add the plugin to docusaurus.config: plugins: [['ask-my-site/docusaurus', { endpoint: 'https://acme-docs-ask.<your-subdomain>.workers.dev/api/ask' }]]
  4. Deploy as you do now. init has deployed nothing."
`;

exports[`ask-my-site init: what it writes per host > Docusaurus on Netlify 1`] = `
{
  "netlify.toml": "[build]
  publish = "build"

# The index the ask-my-site functions answer from, bundled with them.
[functions.ask]
  included_files = ["build/ask-index.json"]

[functions.mcp]
  included_files = ["build/ask-index.json"]
",
  "netlify/functions/ask.mts": "// The ask endpoint, POST /api/ask, as a Netlify Function. Written by \`npx ask-my-site init\`: edit
// it as you like, and init asks before it overwrites it.
//
// It answers from build/ask-index.json, which the build writes and netlify.toml bundles with this
// function. Set OPENAI_API_KEY in the site's environment variables: the build embeds the pages with
// it, and this function embeds questions and calls the model.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { openai } from '@ai-sdk/openai';
import { createAskHandler, memoryRateLimit } from 'ask-my-site/server';

export default createAskHandler({
  index: () => readFile(join(process.cwd(), 'build/ask-index.json'), 'utf8'),
  model: openai('gpt-5.4-mini'),
  // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
  // builds. The index records its model, and a different one here fails loudly. An index built
  // without a key has no vectors: it is searched by keywords, and this model is never called.
  embeddingModel: openai.embedding('text-embedding-3-small'),
  siteName: 'Acme Docs',
  // 10 questions a minute per client, keyed on x-nf-client-connection-ip, the client IP Netlify sets.
  rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000, trustedHeader: 'x-nf-client-connection-ip' }),
  // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
  // with your model provider as well; it is the only hard cap.
  budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
  // A question asked again is answered from memory, without a model call.
  answerCache: true,
});

export const config = { path: '/api/ask' };
",
  "netlify/functions/mcp.mts": "// The MCP endpoint, /api/mcp, as a Netlify Function. Written by \`npx ask-my-site init\`: edit it as
// you like, and init asks before it overwrites it.
//
// It serves build/ask-index.json to agents as search, fetch and list_pages tools. Search is
// keyword-only, so it calls no model: the agent brings its own.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { createMcpHandler, memoryRateLimit } from 'ask-my-site/server';

export default createMcpHandler({
  index: () => readFile(join(process.cwd(), 'build/ask-index.json'), 'utf8'),
  siteName: 'Acme Docs',
  // 60 tool calls a minute per client, keyed on x-nf-client-connection-ip, the client IP Netlify sets.
  rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000, trustedHeader: 'x-nf-client-connection-ip' }),
});

export const config = { path: '/api/mcp' };
",
}
`;

