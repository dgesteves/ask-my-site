exports[`ondocs init: what it writes per host > Starlight in two locales on a Cloudflare Worker 1`] = `
{
  "worker/ondocs.ts": "// The Worker's entry point: the ask endpoint and the MCP endpoint, then the site's files. Written
// by \`npx ondocs init\`: edit it as you like, and init asks before it overwrites it.
//
// It answers from /ask-index.json, which the build writes into the static assets, read through the
// ASSETS binding. Set OPENAI_API_KEY with \`npx wrangler secret put OPENAI_API_KEY\`, and in the
// build's environment: the build embeds the pages with it.
//
// A Worker that has its own entry point already can call \`ondocs(request, env)\` from it: it answers
// the endpoints' paths and returns null for every other request.
import { createOpenAI } from '@ai-sdk/openai';
import { createAskHandler, createMcpHandler, memoryRateLimit } from 'ondocs/server';

interface Env {
  OPENAI_API_KEY: string;
  ASSETS: { fetch: (request: Request) => Promise<Response> };
}

type Handler = (request: Request) => Promise<Response>;
let handlers: { ask: Handler; mcp: Handler } | undefined;

function create(request: Request, env: Env) {
  const openai = createOpenAI({ apiKey: env.OPENAI_API_KEY });
  // One copy of the index for both endpoints, loaded on the first request.
  let text: Promise<string> | undefined;
  const index = () =>
    (text ??= (async () => {
      const response = await env.ASSETS.fetch(new Request(new URL('/ask-index.json', request.url)));
      if (!response.ok) throw new Error(\`/ask-index.json: HTTP \${String(response.status)}\`);
      return response.text();
    })().catch((error: unknown) => {
      text = undefined;
      throw error;
    }));
  // A locale's index, from the site's files.
  const asset = (path: string) => async () => {
    const response = await env.ASSETS.fetch(new Request(new URL(path, request.url)));
    if (!response.ok) throw new Error(\`\${path}: HTTP \${String(response.status)}\`);
    return response.text();
  };
  return {
    ask: createAskHandler({
      index,
      // Each locale's index, which the dialog asks for on that locale's pages.
      indexes: {
        fr: asset('/fr/ask-index.json'),
      },
      model: openai('gpt-5.4-mini'),
      // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
      // builds. The index records its model, and a different one here fails loudly. An index built
      // without a key has no vectors: it is searched by keywords, and this model is never called.
      embeddingModel: openai.embedding('text-embedding-3-small'),
      siteName: 'Acme',
      // 10 questions a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
      rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
      // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
      // with your model provider as well; it is the only hard cap.
      budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
      // A question asked again is answered from memory, without a model call.
      answerCache: true,
    }),
    mcp: createMcpHandler({
      index,
      siteName: 'the Acme docs',
      // 60 tool calls a minute per client, keyed on cf-connecting-ip, the client IP Cloudflare sets.
      rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000, trustedHeader: 'cf-connecting-ip' }),
    }),
  };
}

/** Answers the endpoints' paths, or returns null for any other request. */
export function ondocs(request: Request, env: Env): Promise<Response> | null {
  const { pathname } = new URL(request.url);
  if (pathname !== '/api/ask' && pathname !== '/api/mcp') return null;
  handlers ??= create(request, env);
  return pathname === '/api/ask' ? handlers.ask(request) : handlers.mcp(request);
}

export default {
  fetch(request: Request, env: Env): Promise<Response> {
    return ondocs(request, env) ?? env.ASSETS.fetch(request);
  },
};
",
  "wrangler.jsonc": "{
  "name": "acme",
  "main": "worker/ondocs.ts",
  "assets": { "binding": "ASSETS", "directory": "./dist" }
}
",
}
`;

