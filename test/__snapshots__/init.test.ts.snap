{
  "api/ask.ts": "// The ask endpoint, POST /api/ask, as a Vercel Function. Written by \`npx ondocs init\`: edit it as
// you like, and init asks before it overwrites it.
//
// It answers from dist/ask-index.json, which the build writes and vercel.json bundles with this
// function. Set OPENAI_API_KEY in the project's environment variables: the build embeds the pages
// with it, and this function embeds questions and calls the model.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { openai } from '@ai-sdk/openai';
import { createAskHandler, memoryRateLimit } from 'ondocs/server';

const handler = createAskHandler({
  index: () => readFile(join(process.cwd(), 'dist/ask-index.json'), 'utf8'),
  model: openai('gpt-5.4-mini'),
  // The model the plugins and the CLI embed pages with when OPENAI_API_KEY is set as the site
  // builds. The index records its model, and a different one here fails loudly. An index built
  // without a key has no vectors: it is searched by keywords, and this model is never called.
  embeddingModel: openai.embedding('text-embedding-3-small'),
  siteName: 'Acme',
  // 10 questions a minute per client, keyed on the client IP Vercel sets in X-Forwarded-For.
  rateLimit: memoryRateLimit({ limit: 10, windowMs: 60_000 }),
  // A daily cap for the endpoint, counted per instance: about 500 answers. Set a spend limit
  // with your model provider as well; it is the only hard cap.
  budget: { requestsPerDay: 500, tokensPerDay: 1_500_000 },
  // A question asked again is answered from memory, without a model call.
  answerCache: true,
});

export const POST = handler;
// CORS preflights, for a dialog on another origin (add access-control-* headers with \`headers\`).
export const OPTIONS = handler;
",
  "api/mcp.ts": "// The MCP endpoint, /api/mcp, as a Vercel Function. Written by \`npx ondocs init\`: edit it as you
// like, and init asks before it overwrites it.
//
// It serves dist/ask-index.json to agents as search, fetch and list_pages tools. Search is
// keyword-only, so it calls no model: the agent brings its own.
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import { createMcpHandler, memoryRateLimit } from 'ondocs/server';

const handler = createMcpHandler({
  index: () => readFile(join(process.cwd(), 'dist/ask-index.json'), 'utf8'),
  siteName: 'the Acme docs',
  // 60 tool calls a minute per client, keyed on the client IP Vercel sets in X-Forwarded-For.
  rateLimit: memoryRateLimit({ limit: 60, windowMs: 60_000 }),
});

export const GET = handler;
export const POST = handler;
export const DELETE = handler;
export const OPTIONS = handler;
",
  "vercel.json": "{
  "functions": {
    "api/ask.ts": {
      "includeFiles": "dist/ask-index.json"
    },
    "api/mcp.ts": {
      "includeFiles": "dist/ask-index.json"
    }
  }
}
",
}
