---
// How to connect an AI tool to the site's MCP endpoint, the `mcp` option of ask-my-site/starlight
// or ask-my-site/astro: "Add to Cursor", "Add to VS Code" and "Add to Claude" links, the Claude
// Code command and the JSON for other clients. For an MDX page:
//
//   import McpInstall from 'ask-my-site/astro/McpInstall.astro';
//
//   <McpInstall />
//
// Pass `url` and `name` to show another server. Plain markup, styled as the page's content.
import { mcpInstallLinks } from '../index.js';
import mcp from 'virtual:ask-my-site/mcp';

interface Props {
  /** The MCP server's absolute URL. Default: the plugin's `mcp` option. */
  url?: string;
  /** Its name in the client. Default: the plugin's, from the site title. */
  name?: string;
}

const { url = mcp?.url, name = mcp?.name ?? 'docs' } = Astro.props;
if (!url) {
  throw new Error(
    'McpInstall: set the mcp option of ask-my-site/starlight (or ask-my-site/astro), or pass a url.',
  );
}
const links = mcpInstallLinks({ url, name });
---

<div class="ask-mcp">
  <p>
    These docs are an MCP server at <code>{links.url}</code>. Connect your AI tool to it, and its
    agent can search and read them.
  </p>
  <p class="ask-mcp-links">
    <a class="ask-mcp-link" href={links.cursor}>Add to Cursor</a>
    <a class="ask-mcp-link" href={links.vscode}>Add to VS Code</a>
    <a class="ask-mcp-link" href={links.claude}>Add to Claude</a>
  </p>
  <p>Claude Code:</p>
  <pre><code>{links.claudeCode}</code></pre>
  <p>ChatGPT: add a custom MCP server with this URL at chatgpt.com/plugins.</p>
  <details>
    <summary>Other clients</summary>
    <pre><code>{links.json}</code></pre>
  </details>
</div>
